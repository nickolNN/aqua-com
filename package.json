{
  "name": "aqua-crm",
  "version": "1.0.0",
  "description": "Aqua CRM - Customer Relationship Management System",
  "scripts": {
    "serve": "npm-run-all --parallel serve:backend serve:frontend",
    "serve:backend": "cd src/backend && npm run dev",
    "serve:frontend": "cd src/frontend && npm run dev",
    "build": "npm-run-all build:backend build:frontend",
    "build:backend": "cd src/backend && npm run build",
    "build:frontend": "cd src/frontend && npm run build",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "migrations:generate": "cd src/backend && npm run migrations:generate",
    "migrations:run": "cd src/backend && npm run migrations:run",
    "seed": "cd src/backend && npm run seed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "jest": "^29.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}